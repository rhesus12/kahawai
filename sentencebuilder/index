 wordsEl.innerHTML="";
 shuffle(sentenceTokens(currentSet[current])).forEach((word,i)=>{
  const b=document.createElement("button");b.className="word";b.textContent=word;b.dataset.i=i;
  b.onclick=()=>choose(b,word);wordsEl.appendChild(b);
 });
 document.getElementById("progress").textContent=`Question ${current+1} of 5`;
}

function choose(btn,word){
 if(checked||btn.classList.contains("used"))return;
 btn.classList.add("used");selected.push({word,btn});renderAnswer();checkBtn.disabled=false;
}

function renderAnswer(){
 answerEl.innerHTML="";answerEl.className="answer"+(selected.length?"":" empty");
 if(!selected.length){answerEl.textContent="Your sentence will appear here";return}
 selected.forEach((item,index)=>{
  const s=document.createElement("span");s.className="chosen";s.textContent=item.word;s.title="Tap to remove";
  s.onclick=()=>{if(checked)return;item.btn.classList.remove("used");selected.splice(index,1);renderAnswer();checkBtn.disabled=!selected.length};
  answerEl.appendChild(s);
 });
}

checkBtn.onclick=()=>{
 if(checked)return;
 attempts++;
 checked=true;
 const target=buildSentence(sentenceTokens(currentSet[current])),answer=buildSentence(selected.map(x=>x.word));
 if(answer===target){
  score++;document.getElementById("score").textContent=score;
  feedbackEl.textContent="✓ Correct! +1";feedbackEl.className="feedback correct";
  nextBtn.textContent = (current === currentSet.length - 1) ? "Results" : "Next sentence";
  nextBtn.style.display="block";
 }else{
  feedbackEl.textContent="Not quite. Try again.";feedbackEl.className="feedback wrong";
  tryAgainBtn.style.display="block";
  if(attempts===3){
   const tokens=sentenceTokens(currentSet[current]);
   const hintCount=Math.ceil(tokens.length/2);
   const hint=tokens.slice(0,hintCount).join(" ");
   feedbackEl.textContent="Not quite. Hint: "+hint;
  }
  if(attempts>=4){
   getAnswerBtn.style.display="block";
  }
 }
 checkBtn.disabled=true;
};

tryAgainBtn.onclick=()=>{
 checked=false;selected=[];feedbackEl.textContent="";feedbackEl.className="feedback";
 tryAgainBtn.style.display="none";nextBtn.style.display="none";checkBtn.disabled=true;
 answerEl.className="answer empty";answerEl.textContent="Your sentence will appear here";
 wordsEl.querySelectorAll(".word").forEach(b=>b.classList.remove("used"));
};



getAnswerBtn.onclick=()=>{
 const answer=buildSentence(sentenceTokens(currentSet[current]));
 answerEl.className="answer";
 answerEl.textContent=answer;
 feedbackEl.textContent="";
 feedbackEl.className="feedback";
 getAnswerBtn.style.display="none";
 tryAgainBtn.style.display="none";
 nextBtn.textContent = (current === currentSet.length - 1) ? "Results" : "Next sentence";
 nextBtn.style.display="block";
};


nextBtn.onclick=()=>{
 current++;
 if(current>=currentSet.length){showResults();return}
 loadSentence();
};

function showResults(){
 instructionEl.style.display="none";
 startBtn.style.display="none";
 wordsEl.innerHTML="";wordsEl.style.display="none";
 answerEl.style.display="none";checkBtn.style.display="none";
 tryAgainBtn.style.display="none";getAnswerBtn.style.display="none";nextBtn.style.display="none";
 feedbackEl.textContent="";feedbackEl.style.display="none";
 document.getElementById("progress").textContent="";document.getElementById("progress").style.display="none";
 resultsEl.style.marginTop="0";
 let html="<h2 style='text-align:center;margin-top:0'>You got "+score+" right on the first try.</h2>";
 html+="<h3>Correct answer sentences</h3><ol>";
 currentSet.forEach(s=>html+="<li style='margin:8px 0'>"+buildSentence(sentenceTokens(s))+"</li>");
 html+="</ol><div style='text-align:center;margin-top:18px'><button class='mainbtn' id='playAgain'>Play again</button></div>";
 resultsEl.innerHTML=html;resultsEl.style.display="block";
 document.getElementById("playAgain").onclick=loadSet;
}

levelEl.onchange=()=>{
  // Keep the start screen clean when changing level.
  startBtn.style.display="block";
  instructionEl.textContent="Ready?";
  instructionEl.style.color="#666";
  instructionEl.style.fontStyle="italic";
  wordsEl.innerHTML="";
  answerEl.style.display="none";
  checkBtn.style.display="none";
  resultsEl.style.display="none";
  document.getElementById("progress").textContent="";
};
</script>
</body>
</html>
