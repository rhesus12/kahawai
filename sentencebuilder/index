<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Build the Sentence</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f4f6f8;color:#222}
.container{max-width:760px;margin:auto;padding:18px}
h1{text-align:center;margin:8px 0 4px;font-size:30px}
.subtitle{text-align:center;color:#666;margin-bottom:18px}
.top{display:flex;gap:10px;justify-content:center;align-items:center;flex-wrap:wrap;margin-bottom:18px}
select,button{font:inherit}
select{padding:10px 12px;border:1px solid #bbb;border-radius:8px;background:white}
.score{font-weight:bold;font-size:18px}
.card{background:white;border-radius:14px;padding:20px;box-shadow:0 2px 10px #00000012}
.instruction{text-align:center;font-size:18px;margin-bottom:15px}
.words{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;min-height:58px}
.word{border:1px solid #aaa;background:#fff;border-radius:9px;padding:12px 15px;cursor:pointer;font-weight:bold;font-size:17px}
.word:hover{background:#f0f0f0}
.word.used{opacity:.35;cursor:default}
.answer{min-height:70px;border:2px dashed #bbb;border-radius:10px;padding:12px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;margin:16px 0}
.answer.empty{color:#999}
.answer .chosen{background:#e8f5e9;border:1px solid #9ccc9c;border-radius:8px;padding:10px 13px;cursor:pointer}
.actions{text-align:center}
.mainbtn{background:#333;color:white;border:0;border-radius:9px;padding:12px 25px;cursor:pointer;font-weight:bold}
.mainbtn:disabled{opacity:.45;cursor:default}
.feedback{text-align:center;min-height:34px;margin-top:14px;font-size:18px;font-weight:bold}
.correct{color:#18752b}.wrong{color:#b3261e}
.next{display:none;margin:10px auto 0}
.hint{display:block;margin:14px auto 0;background:#eee;color:#333}.getanswer{display:none;margin:10px auto 0;background:#f28c28;color:white;border:0;border-radius:9px;padding:12px 25px;cursor:pointer;font-weight:bold}
.progress{text-align:center;color:#666;margin-top:14px;font-size:14px}
@media(max-width:520px){
 .container{padding:10px}
 h1{font-size:26px}
 .card{padding:14px}
 .word{font-size:16px;padding:11px 12px}
}
</style>
</head>
